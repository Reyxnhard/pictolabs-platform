# ==============================================================================
# Pictolabs Production Environment Variables Configuration Template
# Copy this file to .env before starting the production deployment:
# cp .env.production.example .env
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL 16) ---
POSTGRES_USER=pictolabs_admin
POSTGRES_PASSWORD=replace_with_secure_random_db_password_min_48_chars
POSTGRES_DB=pictolabs_prod
# Internal container network URL (used by backend service)
DATABASE_URL=postgresql://pictolabs_admin:replace_with_secure_random_db_password_min_48_chars@postgres:5432/pictolabs_prod?schema=public

# --- APPLICATION RUNTIME & SECURITY ---
PORT=4000
NODE_ENV=production
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_secure_random_jwt_secret_min_64_chars
JWT_EXPIRES_IN=7d
DASHBOARD_URL=https://admin.pictolabs.id

# --- PAYMENT GATEWAY CONFIGURATION (Midtrans Production) ---
PAYMENT_GATEWAY_PROVIDER=MIDTRANS
PAYMENT_GATEWAY_ENV=production
MIDTRANS_SERVER_KEY=Mid-server-YOUR_PRODUCTION_SERVER_KEY
MIDTRANS_CLIENT_KEY=Mid-client-YOUR_PRODUCTION_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=true
PAYMENT_WEBHOOK_SECRET=replace_with_custom_webhook_secret_key

# --- CLOUDFLARE R2 OBJECT STORAGE CONFIGURATION ---
# Optional: If omitted or invalid, backend automatically falls back to local uploads directory
R2_ACCOUNT_ID=your_cloudflare_account_id_hash
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pictolabs-media-prod
R2_PUBLIC_DOMAIN=https://dl.pictolabs.id

# --- STORAGE RETENTION POLICIES ---
# Retain customer softfiles in cloud storage for 30 days before auto-cleanup
MEDIA_CLOUD_RETENTION_DAYS=30
# Retain local files on booth kiosk / VPS disk for 7 days
MEDIA_LOCAL_RETENTION_DAYS=7

# --- TRANSACTIONAL EMAIL DELIVERY (Resend) ---
RESEND_API_KEY=re_YOUR_PRODUCTION_RESEND_API_KEY
EMAIL_FROM=Pictolabs <delivery@pictolabs.id>

# --- WHATSAPP UNIFIED ALERT GATEWAY ---
WA_ENABLED=true
WA_GATEWAY_URL=https://api.fonnte.com/send
WA_API_KEY=YOUR_FONNTE_OR_WABLAS_DEVICE_TOKEN
WA_ADMIN_PHONE=081234567890
