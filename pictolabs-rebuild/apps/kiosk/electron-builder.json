{
  "appId": "com.pictolabs.kiosk",
  "productName": "Pictolabs Kiosk",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
